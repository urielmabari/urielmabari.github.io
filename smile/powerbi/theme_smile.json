{
  "name": "SMILE",
  "dataColors": ["#2F6FE0", "#F5A524", "#16A34A", "#DC2626", "#7C3AED", "#0EA5E9", "#0A2560", "#94A3B8"],
  "background": "#FFFFFF",
  "foreground": "#0A2560",
  "tableAccent": "#F5A524",
  "good": "#16A34A",
  "neutral": "#F5A524",
  "bad": "#DC2626",
  "maximum": "#16A34A",
  "center": "#F5A524",
  "minimum": "#DC2626",
  "textClasses": {
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 14, "color": "#0A2560" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#0A2560" },
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#475569" },
    "callout": { "fontFace": "Segoe UI Bold", "fontSize": 28, "color": "#0A2560" }
  },
  "visualStyles": {
    "page": { "*": { "background": [{ "color": { "solid": { "color": "#F4F6FB" } }, "transparency": 0 }] } },
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": false }],
        "dropShadow": [{ "show": true, "preset": "BottomRight" }],
        "visualHeader": [{ "show": true }]
      }
    }
  }
}
